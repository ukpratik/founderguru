<?xml version="1.0" encoding="utf-8"?>
<!-- LLD §7: the database and settings move with the user; caches do not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="founderguru.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="founderguru.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
